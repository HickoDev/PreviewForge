# Reference only. Never save a populated file in Git or a cloud-synced folder.
# The supported kind setup uses scripts/configure-nvidia.ps1 and Kubernetes Secrets.
AI_MODE=mock
AI_LIVE_REQUESTS_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_ACCESS_TOKEN=
AI_CONNECT_TIMEOUT_SECONDS=5
AI_REQUEST_BUDGET_SECONDS=90
AI_MAX_ATTEMPTS=2
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_EVIDENCE_CHARS=20000
AI_MAX_PROMPT_BYTES=32000
AI_MAX_CONCURRENT_REQUESTS=1
