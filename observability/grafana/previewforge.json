{
  "uid": "previewforge",
  "title": "PreviewForge - environments and recovery",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "previewforge",
    "milestone4"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "previewforge-prometheus"
        },
        "query": "label_values(previewforge_build_info, namespace)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "staging",
          "value": "staging"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "previewforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (rate(previewforge_http_requests_total{namespace=~\"$namespace\",route!~\"/health/.*|/metrics\"}[1m]))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "previewforge-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "p95 request latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "previewforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (namespace, le) (rate(previewforge_http_request_duration_seconds_bucket{namespace=~\"$namespace\",route!~\"/health/.*|/metrics\"}[1m])))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "previewforge-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Server error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "previewforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (namespace) (rate(previewforge_http_requests_total{namespace=~\"$namespace\",route!~\"/health/.*|/metrics\",status=~\"5..\"}[1m])) or on(namespace) (0 * sum by(namespace)(rate(previewforge_http_requests_total{namespace=~\"$namespace\",route!~\"/health/.*|/metrics\"}[1m])))) / sum by(namespace)(rate(previewforge_http_requests_total{namespace=~\"$namespace\",route!~\"/health/.*|/metrics\"}[1m]))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "previewforge-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Running source",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "previewforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "previewforge_build_info{namespace=~\"$namespace\"}",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "previewforge-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "title": "API ready replicas",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "previewforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=~\"$namespace\",deployment=\"demo-api\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "previewforge-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "PostgreSQL ready replicas",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "previewforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_statefulset_status_replicas_ready{namespace=~\"$namespace\",statefulset=\"demo-postgres\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "previewforge-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Argo synchronization",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "previewforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "argocd_app_info{name=~\"$namespace\"}",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "previewforge-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "title": "Active alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "previewforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{namespace=~\"$namespace\",alertstate=\"firing\"}",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{namespace}}",
          "datasource": {
            "type": "prometheus",
            "uid": "previewforge-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
