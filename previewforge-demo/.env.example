# Documentation of non-secret container settings. The root wrapper supplies them.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=previewforge
DATABASE_USER=previewforge
DATABASE_PASSWORD_FILE=/run/secrets/db_password
ENVIRONMENT_NAME=local
SOURCE_SHA=local-uncommitted
# Deliberately dummy AWS credentials; never substitute real credentials here.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=test
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
AWS_ENDPOINT_URL=http://floci:4566
